# Copy to .env and adjust. Never commit a real .env.

# Database. Local development uses SQLite (relative to prisma/). Leave blank to use file:./dev.db.
# For PostgreSQL use prisma/postgres/schema.prisma, e.g. postgresql://user:password@localhost:5432/kisan_rin
DATABASE_URL=

# Private upload folder (outside any public path). Defaults to storage/uploads.
UPLOAD_DIR=

# Folder with exported model JSON. Defaults to ml/artifacts.
MODEL_DIR=

# Set to 1 only when serving a production build over plain http (e.g. local Docker), so the
# session cookie is not marked Secure.
INSECURE_COOKIES=

# Optional: Sarvam AI key for the voice assistant (speech and translation). The portal works without it.
SARVAM_API_KEY=
